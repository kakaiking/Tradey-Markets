# ==========================================
# DATABASE CONNECTION STRINGS (Prisma 7 & PG Adapter)
# ==========================================

# 1. Vercel Postgres Environment Variables (from your Vercel Dashboard)
# POSTGRES_PRISMA_URL is the pooled connection string (used in production queries)
# POSTGRES_URL_NON_POOLING is the direct connection string (used for schema migrations)
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# 2. Local Fallback Database Variable
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Shared secret for Kakaitec POST /api/webhooks/provision (HMAC-SHA256)
KAKAITEC_PROVISIONING_SECRET="generate-a-strong-secret"

# ==========================================
# AUTH
# ==========================================
JWT_SECRET="generate-a-strong-secret"

# Public app origin (used for OAuth redirects / absolute URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Google OAuth (Web application client)
# Redirect URI must match Google Cloud Console exactly, e.g.:
# http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google/callback"
